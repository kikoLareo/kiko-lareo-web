---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Imagen para compartir en redes (ruta relativa o absoluta) */
  ogImage?: string | null;
  /** Bloques JSON-LD (schema.org) a inyectar en el <head> */
  jsonLd?: object[];
  /** true en páginas que Google no debe indexar (ej: /gracias) */
  noindex?: boolean;
}

const { title, description, ogImage, jsonLd = [], noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImg = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
---

<!DOCTYPE html>
<html lang="es">
<head>
<script is:inline>
  // Marca que hay JS antes de pintar: evita el "flash" de contenido oculto
  document.documentElement.classList.add('js');
</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}

<script is:inline>
  // Los correos de Netlify Identity (invitación al panel, recuperación de
  // contraseña) traen un token en el enlace y aterrizan en la portada;
  // el panel vive en /admin, así que reenviamos el token allí.
  (function () {
    var h = window.location.hash;
    if (
      /^#(invite_token|recovery_token|confirmation_token|email_change_token)=/.test(h) &&
      window.location.pathname.indexOf('/admin') !== 0
    ) {
      window.location.replace('/admin/' + h);
    }
  })();
</script>
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Kiko Lareo® — Fotógrafo y Videógrafo" />
<meta property="og:locale" content="es_ES" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImg && <meta property="og:image" content={ogImg} />}
<meta name="twitter:card" content={ogImg ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImg && <meta name="twitter:image" content={ogImg} />}

{jsonLd.map((bloque) => (
  <script type="application/ld+json" set:html={JSON.stringify(bloque)} />
))}

<!-- Fuentes alojadas en la propia web (ver src/styles/fonts.css). Precargamos
     los dos pesos más usados del titular para que no parpadee al cargar. -->
<link rel="preload" href="/fonts/bricolage-grotesque-800-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/bricolage-grotesque-400-latin.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
<a href="#contenido" class="skip">SALTAR AL CONTENIDO →</a>
<slot />

<!-- Visor a pantalla completa. Se rellena al pulsar una foto de cualquier
     galería marcada con data-visor. Sin JS no estorba: queda oculto y las
     fotos siguen viéndose en su sitio. -->
<div class="visor" id="visor" hidden role="dialog" aria-modal="true" aria-label="Foto ampliada">
  <img class="visor-img" id="visor-img" alt="" />
  <button type="button" class="visor-btn visor-cerrar" id="visor-cerrar" aria-label="Cerrar">✕</button>
  <button type="button" class="visor-btn visor-prev" id="visor-prev" aria-label="Foto anterior">←</button>
  <button type="button" class="visor-btn visor-next" id="visor-next" aria-label="Foto siguiente">→</button>
  <div class="visor-pie">
    <span id="visor-texto"></span>
    <span class="visor-contador" id="visor-contador"></span>
  </div>
</div>
<script>
  // Tarjetas con historia: HISTORIA ↻ gira la tarjeta
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('.flip-btn');
    if (btn) btn.closest('.flip')?.classList.toggle('flipped');
  });

  // Aparición al hacer scroll: revela los bloques con .reveal cuando entran
  // (o cuando ya se han pasado, p. ej. al saltar con el menú, para que ninguna
  // sección quede en blanco). Con reducir-movimiento, se muestran directos.
  const reveals = Array.from(document.querySelectorAll('.reveal'));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) {
    reveals.forEach((e) => e.classList.add('visible'));
  } else {
    const check = () => {
      const h = window.innerHeight;
      for (const e of reveals) {
        if (!e.classList.contains('visible') && e.getBoundingClientRect().top < h * 0.88) {
          e.classList.add('visible');
        }
      }
    };
    check();
    addEventListener('scroll', check, { passive: true });
    addEventListener('resize', check, { passive: true });
    addEventListener('hashchange', () => setTimeout(check, 60));
    setTimeout(check, 3000); // red de seguridad
  }

  // ------------------------------------------------------------------
  // Visor a pantalla completa de las galerías.
  // Entra por las fotos que estén dentro de un contenedor [data-visor].
  // Se dejan fuera a propósito las tarjetas que giran (.flip), que ya
  // tienen su propio gesto, y los vídeos, que llevan sus controles.
  // ------------------------------------------------------------------
  const visor = document.getElementById('visor');
  const visorImg = document.getElementById('visor-img') as HTMLImageElement | null;
  const visorTexto = document.getElementById('visor-texto');
  const visorContador = document.getElementById('visor-contador');

  if (visor && visorImg) {
    const fotos = Array.from(
      document.querySelectorAll<HTMLImageElement>('[data-visor] .slot.filled img')
    ).filter((img) => !img.closest('.flip'));

    if (fotos.length === 0) {
      visor.remove();
    } else {
      let actual = 0;
      let origen: HTMLElement | null = null;

      const pintar = () => {
        const img = fotos[actual];
        visorImg.src = img.currentSrc || img.src;
        visorImg.alt = img.alt || '';
        if (visorTexto) visorTexto.textContent = img.alt || '';
        if (visorContador) {
          visorContador.textContent = `${String(actual + 1).padStart(2, '0')} / ${String(fotos.length).padStart(2, '0')}`;
        }
      };

      const abrir = (i: number, desde: HTMLElement) => {
        actual = i;
        origen = desde;
        pintar();
        visor.hidden = false;
        document.body.classList.add('visor-abierto');
        (document.getElementById('visor-cerrar') as HTMLElement | null)?.focus();
      };

      const cerrar = () => {
        visor.hidden = true;
        visorImg.removeAttribute('src');
        document.body.classList.remove('visor-abierto');
        origen?.focus();
        origen = null;
      };

      const mover = (paso: number) => {
        actual = (actual + paso + fotos.length) % fotos.length;
        pintar();
      };

      fotos.forEach((img, i) => {
        const caja = img.closest('.slot') as HTMLElement | null;
        if (!caja) return;
        caja.classList.add('ampliable');
        caja.tabIndex = 0;
        caja.setAttribute('role', 'button');
        caja.setAttribute('aria-label', `Ampliar: ${img.alt || 'foto'}`);
        caja.addEventListener('click', () => abrir(i, caja));
        caja.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            abrir(i, caja);
          }
        });
      });

      document.getElementById('visor-cerrar')?.addEventListener('click', cerrar);
      document.getElementById('visor-prev')?.addEventListener('click', () => mover(-1));
      document.getElementById('visor-next')?.addEventListener('click', () => mover(1));
      // Pulsar el fondo (no la foto ni los botones) también cierra
      visor.addEventListener('click', (e) => {
        if (e.target === visor) cerrar();
      });
      addEventListener('keydown', (e) => {
        if (visor.hidden) return;
        if (e.key === 'Escape') cerrar();
        else if (e.key === 'ArrowLeft') mover(-1);
        else if (e.key === 'ArrowRight') mover(1);
      });
    }
  }
</script>
</body>
</html>
