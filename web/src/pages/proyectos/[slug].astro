---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Slot from '../../components/Slot.astro';
import CarruselVertical from '../../components/CarruselVertical.astro';
import { CATEGORIAS } from '../../lib/categorias';
import { codigoArchivo, ACENTOS } from '../../lib/archivo';
import { optim } from '../../lib/imagen';
import { migas, persona } from '../../lib/seo';

export async function getStaticPaths() {
  const proyectos = (await getCollection('proyectos')).sort(
    (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()
  );
  return proyectos.map((proyecto, i) => ({
    params: { slug: proyecto.id },
    // Encadena los proyectos: el "siguiente" es el anterior en el tiempo
    // (y el último vuelve al más reciente).
    props: {
      proyecto,
      siguiente: proyectos[(i + 1) % proyectos.length],
      codigo: codigoArchivo(proyecto, proyectos),
    },
  }));
}

const { proyecto, siguiente, codigo } = Astro.props;
const d = proyecto.data;
const { Content } = await render(proyecto);

const cat = CATEGORIAS.find((c) => c.id === d.categoria)!;
const haySiguiente = siguiente.id !== proyecto.id;
const acento = ACENTOS[d.color] ?? ACENTOS.rojo;
const hayResultado = d.galeria.length > 0 || d.fotos.length > 0 || d.video;

// Los embeds de Instagram/TikTok son verticales: se muestran en un marco
// estrecho centrado (no en la caja ancha de YouTube/Vimeo).
const urlVideo = d.video?.url ?? '';
const embedVertical = /instagram\.com|tiktok\.com/.test(urlVideo);

// Galería con el ritmo del diseño: 1 grande + 2 apiladas, luego filas de 3
const [g1, g2, g3, ...resto] = d.galeria;

// Las fotos del proyecto (con pie y sin pie) se cuentan como UNA secuencia
// y se enseñan en el carrusel vertical. Los clips de vídeo van aparte:
// llevan sus propios controles y no encajan en la pila.
const piezasCarrusel = [
  ...d.galeria.filter((p) => p.imagen && !p.clip).map((p) => ({ imagen: p.imagen!, etiqueta: p.etiqueta })),
  ...d.fotos.map((f) => ({ imagen: f })),
];
const clips = d.galeria.filter((p) => p.clip);
// Con una sola foto un carrusel no aporta nada: se enseña en la rejilla.
const hayCarrusel = piezasCarrusel.length >= 2;

const lugar = d.localidad ?? 'Galicia';
const descripcion =
  d.descripcion_seo ??
  `${d.titulo} (${d.anio}): ${d.servicios.toLowerCase()} para ${d.cliente} en ${lugar}. Proyecto de Kiko Lareo, fotógrafo y videógrafo en A Coruña.`;

const jsonLd = [
  migas(Astro.site!, [
    { nombre: 'Inicio', ruta: '/' },
    { nombre: cat.titulo, ruta: `/${d.categoria}/` },
    { nombre: d.titulo, ruta: `/proyectos/${proyecto.id}/` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: d.titulo,
    description: descripcion,
    dateCreated: d.fecha.toISOString().slice(0, 10),
    creator: persona(Astro.site!),
    contentLocation: { '@type': 'Place', name: lugar },
    ...(d.portada ? { image: new URL(d.portada, Astro.site).toString() } : {}),
  },
];
---

<Base title={`${d.titulo} — ${cat.titulo.toLowerCase()} en ${lugar} | Kiko Lareo®`} description={descripcion} ogImage={d.portada} jsonLd={jsonLd}>

<Nav variante="subpagina" etiqueta={`${cat.titulo} / ${codigo}`} />

<main id="contenido" style={`--acento:${acento}`}>
<!-- Hero: la portada llega "creciendo" desde la tarjeta (view transition) -->
<header class="project-hero" style={`view-transition-name: proyecto-${proyecto.id}`}>
  <Slot imagen={d.portada} etiqueta="Portada del proyecto" ancho={2000} prioridad />
  <div class="project-hero-code">[ {codigo} ] / {cat.titulo}{d.localidad ? ` / ${d.localidad.toUpperCase()}` : ''}</div>
  <h1 class="project-hero-title" style="margin:0">{d.titulo.toUpperCase()}</h1>
</header>

<!-- Ficha -->
<section class="project-meta">
  <div><div class="label">CLIENTE</div><div class="value">{d.cliente}</div></div>
  <div><div class="label">AÑO</div><div class="value">{d.anio}</div></div>
  <div><div class="label">SERVICIOS</div><div class="value">{d.servicios}</div></div>
  <div><div class="label">ENTREGA</div><div class="value">{d.entrega}</div></div>
</section>

<!-- Caso de estudio: el reto y la idea (solo si están rellenos) -->
{(d.reto || d.idea) && (
  <section class="caso reveal">
    {d.reto && (
      <div>
        <div class="caso-label">EL RETO</div>
        <p class={`caso-texto${d.reto.length <= 90 ? ' corto' : ''}`}>{d.reto}</p>
      </div>
    )}
    {d.idea && (
      <div>
        <div class="caso-label">LA IDEA</div>
        <p class={`caso-texto${d.idea.length <= 90 ? ' corto' : ''}`}>{d.idea}</p>
      </div>
    )}
  </section>
)}

<!-- La ejecución: los pasos del trabajo -->
{d.ejecucion.length > 0 && (
  <section class="ejecucion reveal">
    <div class="caso-label">LA EJECUCIÓN</div>
    <ol class="pasos">
      {d.ejecucion.map((paso, i) => (
        <li><span class="paso-num">{String(i + 1).padStart(2, '0')}</span> {paso}</li>
      ))}
    </ol>
  </section>
)}

<!-- Historia -->
<section class="project-story reveal">
  <h2 set:html={d.titular.trim().replace(/\n/g, '<br>')} />
  <div class="project-story-text">
    <Content />
  </div>
</section>

<!-- La acreditación: el documento real con el que se entró al encargo -->
{d.acreditacion?.imagen && (
  <section class="acreditacion reveal">
    <div class="acreditacion-pase">
      <img
        src={optim(d.acreditacion.imagen, 700)}
        alt={d.acreditacion.pie ?? `Acreditación de ${d.titulo}`}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="acreditacion-info">
      <div class="caso-label">LA ACREDITACIÓN</div>
      <p class="acreditacion-pie">{d.acreditacion.pie ?? `Con esto se entró a ${d.titulo}.`}</p>
      <div class="acreditacion-code">[ {codigo} ] / {cat.titulo}</div>
    </div>
  </section>
)}

<!-- El resultado: galería y vídeo -->
{hayResultado && <div class="caso-label resultado-label reveal">EL RESULTADO</div>}
{hayCarrusel ? (
  <CarruselVertical
    piezas={piezasCarrusel}
    titulo={d.titulo}
    localidad={d.localidad}
    anio={d.anio}
  />
) : d.galeria.length > 0 ? (
  <>
    <section class="gallery-top" data-visor>
      <div class="big">{g1 && <Slot imagen={g1.imagen} video={g1.clip} alt={g1.etiqueta} etiqueta={g1.etiqueta} />}</div>
      <div class="stack">
        <div>{g2 && <Slot imagen={g2.imagen} video={g2.clip} alt={g2.etiqueta} etiqueta={g2.etiqueta} />}</div>
        <div>{g3 && <Slot imagen={g3.imagen} video={g3.clip} alt={g3.etiqueta} etiqueta={g3.etiqueta} />}</div>
      </div>
    </section>
    {resto.length > 0 && (
      <section class="gallery-row" data-visor>
        {resto.map((pieza) => (
          <div><Slot imagen={pieza.imagen} video={pieza.clip} alt={pieza.etiqueta} etiqueta={pieza.etiqueta} /></div>
        ))}
      </section>
    )}
  </>
) : d.fotos.length > 0 ? (
  <section class="gallery-row gallery-fotos" data-visor>
    {d.fotos.map((foto, i) => (
      <div><Slot imagen={foto} alt={`${d.titulo} — foto ${i + 1}`} etiqueta="" /></div>
    ))}
  </section>
) : null}

<!-- Los clips de vídeo van fuera del carrusel: llevan sus propios controles -->
{hayCarrusel && clips.length > 0 && (
  <section class="gallery-row">
    {clips.map((pieza) => (
      <div><Slot imagen={pieza.imagen} video={pieza.clip} alt={pieza.etiqueta} etiqueta={pieza.etiqueta} /></div>
    ))}
  </section>
)}

<!-- Vídeo -->
{d.video && (
  <section class="aftermovie">
    <div class="aftermovie-header">
      <span class="aftermovie-title">{d.video.titulo}</span>
      <span class="aftermovie-label">{d.video.etiqueta}</span>
    </div>
    <div class={`aftermovie-media${d.video.url && !d.video.archivo ? (embedVertical ? ' embed-vertical' : ' embed-ancho') : ''}`}>
      {d.video.archivo ? (
        <video
          src={d.video.archivo}
          poster={d.video.imagen ?? undefined}
          controls
          playsinline
          preload="metadata"
          style="width:100%; height:100%; object-fit:cover; display:block"
          aria-label={d.video.titulo}
        ></video>
      ) : d.video.url ? (
        <iframe
          src={d.video.url}
          class="embed-frame"
          scrolling="no"
          style="width:100%; border:none; display:block"
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          allowfullscreen
          title={d.video.titulo}
        ></iframe>
      ) : (
        <>
          <Slot imagen={d.video.imagen} etiqueta="Fotograma del vídeo — añade la URL desde el panel" />
          <div class="play-overlay"><div class="play-btn">PLAY</div></div>
        </>
      )}
    </div>
  </section>
)}

<!-- Siguiente proyecto / volver -->
{haySiguiente ? (
  <a href={`/proyectos/${siguiente.id}/`} class="next-project">
    <div>
      <div class="label">SIGUIENTE HISTORIA</div>
      <div class="title">{siguiente.data.titulo.toUpperCase()} →</div>
    </div>
    <div class="thumb" style={`view-transition-name: proyecto-${siguiente.id}`}>
      <Slot imagen={siguiente.data.portada} etiqueta="Miniatura siguiente" />
    </div>
  </a>
) : (
  <a href={`/${d.categoria}/`} class="next-project">
    <div>
      <div class="label">VOLVER A LA CATEGORÍA</div>
      <div class="title">{cat.titulo} →</div>
    </div>
  </a>
)}

<!-- Barra de progreso: IDEA ━ FORMA ━ RESULTADO -->
<div class="progreso" aria-hidden="true">
  <div class="relleno"></div>
  <span>IDEA</span><span>FORMA</span><span>RESULTADO</span>
</div>
</main>

<footer class="footer-bar footer-proyecto">
  <span>© {new Date().getFullYear()} KIKO LAREO®</span>
  <span class="footer-legal"><a href="/aviso-legal/">AVISO LEGAL</a><a href="/privacidad/">PRIVACIDAD</a><a href="/#contacto">CONTACTO →</a></span>
</footer>

<script>
  // ------------------------------------------------------------------
  // Carrusel vertical con relieve: la foto elegida viene al frente y las
  // demás se van hacia atrás. Sin JS se ve la primera y los pies siguen
  // en el HTML, así que la página nunca queda vacía.
  // ------------------------------------------------------------------
  document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach((raiz) => {
    const pila = raiz.querySelector<HTMLElement>('.carrusel-pila');
    const relleno = raiz.querySelector<HTMLElement>('.carrusel-pista i');
    const idx = raiz.querySelector<HTMLElement>('[data-idx]');
    const pie = raiz.querySelector<HTMLElement>('[data-pie]');
    if (!pila) return;

    const figuras = Array.from(pila.querySelectorAll<HTMLElement>('figure'));
    const pies = figuras.map((f) => f.querySelector('img')?.getAttribute('alt') ?? '');
    if (figuras.length === 0) return;

    let sel = 0;
    pila.classList.add('listo');

    const colocar = () => {
      figuras.forEach((fig, i) => {
        const d = i - sel;
        const a = Math.abs(d);
        if (a > 3) {
          fig.style.opacity = '0';
          fig.style.pointerEvents = 'none';
          fig.style.transform = `translate(-50%,-50%) translateY(${Math.sign(d) * 240}px) translateZ(-700px)`;
          fig.classList.remove('activa');
          fig.setAttribute('aria-selected', 'false');
          return;
        }
        fig.style.pointerEvents = '';
        fig.style.opacity = String(1 - a * 0.22);
        fig.style.filter = a ? `blur(${a * 1.2}px)` : 'none';
        fig.style.zIndex = String(50 - a);
        fig.style.transform =
          `translate(-50%,-50%) translateY(${d * 62}px) translateZ(${-a * 165}px) scale(${1 - a * 0.05}) rotateX(${d * -3}deg)`;
        fig.classList.toggle('activa', a === 0);
        fig.setAttribute('aria-selected', String(a === 0));
      });
      if (idx) idx.textContent = String(sel + 1).padStart(2, '0');
      if (pie) pie.textContent = pies[sel];
      if (relleno) {
        relleno.style.height = `${100 / figuras.length}%`;
        relleno.style.top = `${(sel * 100) / figuras.length}%`;
      }
    };

    const ir = (n: number) => {
      sel = Math.max(0, Math.min(figuras.length - 1, n));
      colocar();
    };

    figuras.forEach((fig) => {
      fig.querySelector('button')?.addEventListener('click', () => ir(Number(fig.dataset.i)));
    });
    raiz.querySelector('[data-sube]')?.addEventListener('click', () => ir(sel - 1));
    raiz.querySelector('[data-baja]')?.addEventListener('click', () => ir(sel + 1));

    pila.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); ir(sel - 1); }
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); ir(sel + 1); }
    });

    // Rueda del ratón: solo se queda el scroll mientras quedan fotos.
    // Al llegar al extremo suelta la página, para no atrapar al visitante.
    let freno = 0;
    pila.addEventListener('wheel', (e) => {
      const baja = e.deltaY > 0;
      if ((baja && sel === figuras.length - 1) || (!baja && sel === 0)) return;
      e.preventDefault();
      const ahora = Date.now();
      if (ahora - freno < 260) return;
      freno = ahora;
      ir(sel + (baja ? 1 : -1));
    }, { passive: false });

    // Arrastre vertical, con el dedo o con el ratón
    let y0: number | null = null;
    let selInicio = 0;
    pila.addEventListener('pointerdown', (e) => {
      y0 = e.clientY;
      selInicio = sel;
      pila.classList.add('agarrando');
      pila.setPointerCapture(e.pointerId);
    });
    pila.addEventListener('pointermove', (e) => {
      if (y0 === null) return;
      const paso = Math.round((y0 - e.clientY) / 52);
      if (paso !== sel - selInicio) ir(selInicio + paso);
    });
    ['pointerup', 'pointercancel'].forEach((ev) =>
      pila.addEventListener(ev, () => { y0 = null; pila.classList.remove('agarrando'); })
    );

    colocar();
  });

  // La barra de progreso avanza con el scroll del proyecto
  const relleno = document.querySelector('.progreso .relleno') as HTMLElement | null;
  const actualizar = () => {
    const h = document.documentElement;
    const total = h.scrollHeight - h.clientHeight;
    if (relleno) relleno.style.width = `${total > 0 ? Math.min(100, (h.scrollTop / total) * 100) : 0}%`;
  };
  addEventListener('scroll', actualizar, { passive: true });
  actualizar();

  // La barra de progreso se retira cuando el pie entra en pantalla, para
  // que nunca se solape con el "© / CONTACTO".
  const barra = document.querySelector('.progreso');
  const pie = document.querySelector('.footer-proyecto');
  if (barra && pie) {
    new IntersectionObserver((entradas) => {
      entradas.forEach((e) => barra.classList.toggle('oculta', e.isIntersecting));
    }, { threshold: 0.05 }).observe(pie);
  }

  // El embed de Instagram informa de su alto real por postMessage: ajustamos
  // el iframe a esa altura para que se vea entero, sin scroll interno.
  const frame = document.querySelector('.embed-vertical .embed-frame') as HTMLIFrameElement | null;
  if (frame) {
    addEventListener('message', (e) => {
      if (typeof e.origin !== 'string' || e.origin.indexOf('instagram.com') === -1) return;
      if (e.source !== frame.contentWindow) return;
      try {
        const datos = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
        const alto = datos?.details?.height ?? datos?.height;
        if (alto) frame.style.height = alto + 'px';
      } catch {}
    });
    // Da un empujón a Instagram para que reporte medidas
    const pedirMedida = () => {
      frame.contentWindow?.postMessage(
        JSON.stringify({ type: 'em.MEASURE', details: {} }),
        'https://www.instagram.com'
      );
    };
    frame.addEventListener('load', () => {
      pedirMedida();
      setTimeout(pedirMedida, 600);
      setTimeout(pedirMedida, 1500);
    });
  }
</script>

</Base>
